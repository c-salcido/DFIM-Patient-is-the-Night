    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[0]
      value: 'Kitty: The moon''s beautiful tonight. '
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[1]
      value: It is, you should come out with me!
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[2]
      value: 'Kitty: Maybe later.. but I''ll stay here a while longer. She needs
        me'
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[3]
      value: She'll forget all her worries once I've built the perfect dream for
        her, you'll see!
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[4]
      value: There's nothing that a little magic can't fix
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[5]
      value: 'Kitty: I hope you''re right about that.'
      objectReference: {fileID: 0}
    - target: {fileID: 1410756236943757343, guid: 743151898799146c3a3571d32d4344dc, type: 3}
      propertyPath: dialogue.sentences.Array.data[6]
      value: 'Kitty: Goodbye for now'
      objectReference: {fileID: 0}
